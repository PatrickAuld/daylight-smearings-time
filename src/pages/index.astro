form.pledge button{
  padding:16px 30px;border:none;border-radius:2px;cursor:pointer;
  background:var(--dawn);color:#fff;
  font-family:var(--sans);font-weight:700;font-size:14.5px;letter-spacing:.03em;
  transition:background .2s,transform .15s;
}
