.pledge-count{
  font-family:var(--mono);font-size:12px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--gold);margin-top:34px;
}
.pledge-count b{font-size:15px}
form.pledge{
  margin:22px auto 0;max-width:520px;display:flex;gap:10px;
}
@media(max-width:560px){form.pledge{flex-direction:column}}
form.pledge input[type=email]{
  flex:1;padding:16px 20px;border-radius:2px;
  border:1px solid rgba(246,240,226,.25);
  background:rgba(246,240,226,.07);color:#FBF6EA;
  font-family:var(--mono);font-size:14px;
  outline:none;transition:border-color .2s;
}
form.pledge input[type=email]::placeholder{color:rgba(246,240,226,.4)}
