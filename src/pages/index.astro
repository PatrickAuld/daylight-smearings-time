  display:none;margin:30px auto 0;max-width:520px;
  border:1px solid var(--gold);border-radius:3px;padding:20px 24px;
  font-family:var(--mono);font-size:13px;color:var(--gold);line-height:1.7;
}

.chart-card .key.loc{margin-left:auto;color:var(--ink-soft);opacity:.8}
#today-line{display:block;margin-top:14px}

/* footer */
footer.site{
  background:#0B1622;color:rgba(246,240,226,.55);
  padding:54px 0 40px;font-size:13px;
}
footer.site .wrap{display:grid;grid-template-columns:1.2fr .8fr;gap:48px}
@media(max-width:820px){footer.site .wrap{grid-template-columns:1fr}}
footer.site h4{
  font-family:var(--mono);font-size:10.5px;letter-spacing:.22em;text-transform:uppercase;
  color:var(--gold);margin-bottom:14px;
}
footer.site ol{padding-left:18px;display:grid;gap:8px;font-size:12.5px;line-height:1.6}
footer.site .fine{margin-top:26px;font-size:12px;line-height:1.8;color:rgba(246,240,226,.4)}
footer.site .legal{
  border-top:1px solid rgba(246,240,226,.1);margin-top:40px;padding-top:22px;
  font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;
  display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;
  color:rgba(246,240,226,.35);
}
</style>

<script>
import {
  smearedNow, getLocation, sunEvents, fmtHMS, fmtDur, fmtLegacyTime, fmtCoords,
  SUNRISE_H, SUNSET_H, HOUR, DAY,
} from '../scripts/smear.js';

/* ═══════════════════════════════════════════════════════════════
   CONFIG — Google Form wiring
   ───────────────────────────────────────────────────────────────
   The pledge form submits to a Google Form. To connect yours:
     1. Create a Google Form with one short-answer question ("Email").
     2. Open the live form and find, in its HTML:
          - the action URL:  https://docs.google.com/forms/d/e/<FORM_ID>/formResponse
          - the field name:  entry.<NUMBERS>
     3. Replace the two constants below.
   Until configured, the form still shows the success state locally
   so the site can be demoed.
   ═══════════════════════════════════════════════════════════════ */
const GOOGLE_FORM_ACTION = "https://docs.google.com/forms/d/e/YOUR_FORM_ID/formResponse";
const GOOGLE_FORM_EMAIL_FIELD = "entry.0000000000";

const $ = (id) => document.getElementById(id);
const loc = getLocation();

/* ── masthead clock ── */
function navTick() {
  const { h, m, s } = smearedNow(loc);
  $("nav-clock").textContent = fmtHMS(h, m, s);
}
navTick();
setInterval(navTick, 200);

/* ── §02: today's hour lengths at the reference location ── */
function renderToday() {
  const now = new Date();
  const today = sunEvents(new Date(now.getFullYear(), now.getMonth(), now.getDate(), 12).getTime(), loc);
  const tomorrow = sunEvents(today.set.getTime() + 12 * HOUR, loc);
  const dayHour = (today.set - today.rise) / 12;
  const nightHour = (tomorrow.rise - today.set) / 12;
  const where = loc.source === "device" ? "At your location" : "In " + loc.name;
  $("today-line").innerHTML =
    "<strong>" + where + " today, each daylight hour lasts " + fmtDur(dayHour) +
    " and each night hour " + fmtDur(nightHour) + ".</strong> Legacy clocks recorded this " +
    "morning's sunrise at " + fmtLegacyTime(today.rise) + ". Daylight Smearings Time " +
    "recorded it at 6:00 a.m., as it will tomorrow.";
}
renderToday();

/* ── §02: a year of sunrises and sunsets, legacy vs smeared ── */
function renderChart() {
  const NS = "http://www.w3.org/2000/svg";
  const X0 = 50, X1 = 430, Y0 = 30, Y1 = 230;
  const year = new Date().getFullYear();
  const daysInYear = (new Date(year + 1, 0, 1) - new Date(year, 0, 1)) / DAY;
  const hrs = (d) => d.getHours() + d.getMinutes() / 60;

  const pts = [];
  for (let i = 0; i < daysInYear; i += 2) {
    const e = sunEvents(new Date(year, 0, 1 + i, 12).getTime(), loc);
    pts.push({ i, rise: hrs(e.rise), set: hrs(e.set) });
  }
  const lo = Math.max(0, Math.floor(Math.min(SUNRISE_H, ...pts.map(p => p.rise))) - 1);
  const hi = Math.min(24, Math.ceil(Math.max(SUNSET_H, ...pts.map(p => p.set))) + 1);
  const x = (i) => X0 + (i / (daysInYear - 1)) * (X1 - X0);
  const y = (h) => Y1 - ((h - lo) / (hi - lo)) * (Y1 - Y0);
  const line = (key) => pts.map((p, k) => (k ? "L" : "M") + x(p.i).toFixed(1) + " " + y(p[key]).toFixed(1)).join(" ");
  const hourLabel = (h) => (h % 12 || 12) + (h < 12 || h === 24 ? "am" : "pm");
  const halo = 'paint-order="stroke" stroke="#F6F0E2" stroke-width="4" stroke-linejoin="round"';

  let svg = "";
  // smeared daylight band
  svg += `<rect x="${X0}" y="${y(SUNSET_H)}" width="${X1 - X0}" height="${y(SUNRISE_H) - y(SUNSET_H)}" fill="rgba(224,102,42,.07)" />`;
  // grid + y labels
  svg += `<g stroke="rgba(30,42,56,.12)" stroke-width="1">`;
  const ticks = [];
  for (let h = Math.ceil(lo / 3) * 3; h <= hi; h += 3) ticks.push(h);
  ticks.forEach(h => { svg += `<line x1="${X0}" y1="${y(h)}" x2="${X1}" y2="${y(h)}" />`; });
  svg += `</g>`;
  svg += `<line x1="${X0}" y1="${Y0 - 6}" x2="${X0}" y2="${Y1}" stroke="rgba(30,42,56,.45)" stroke-width="1.2" />`;
  svg += `<line x1="${X0}" y1="${Y1}" x2="${X1}" y2="${Y1}" stroke="rgba(30,42,56,.45)" stroke-width="1.2" />`;
  svg += `<g font-family="IBM Plex Mono,monospace" font-size="10" fill="#46566A">`;
  ticks.forEach(h => { svg += `<text x="${X0 - 8}" y="${y(h) + 3.5}" text-anchor="end">${hourLabel(h)}</text>`; });
  "JFMAMJJASOND".split("").forEach((c, m) => {
    const mid = (new Date(year, m, 15) - new Date(year, 0, 1)) / DAY;
    svg += `<text x="${x(mid).toFixed(1)}" y="${Y1 + 18}" text-anchor="middle">${c}</text>`;
  });
  svg += `<text x="240" y="${Y1 + 44}" text-anchor="middle" letter-spacing="2">SUNRISE AND SUNSET, ${year}</text>`;
  svg += `</g>`;

  // today marker
  const doy = (new Date() - new Date(year, 0, 1)) / DAY;
  svg += `<line x1="${x(doy)}" y1="${Y0 - 6}" x2="${x(doy)}" y2="${Y1}" stroke="rgba(30,42,56,.35)" stroke-width="1" stroke-dasharray="2 3" />`;
  svg += `<text x="${x(doy)}" y="${Y0 - 10}" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="9" letter-spacing="1.5" fill="#46566A">TODAY</text>`;

  // legacy: wandering, jumping
  svg += `<g fill="none" stroke="#B5472F" stroke-width="2.2" stroke-dasharray="6 4" stroke-linejoin="round">`;
  svg += `<path d="${line("rise")}" /><path d="${line("set")}" /></g>`;

  // smeared: flat, forever
  svg += `<g stroke="#E0662A" stroke-width="3" stroke-linecap="round">`;
  svg += `<line x1="${X0}" y1="${y(SUNSET_H)}" x2="${X1}" y2="${y(SUNSET_H)}" />`;
  svg += `<line x1="${X0}" y1="${y(SUNRISE_H)}" x2="${X1}" y2="${y(SUNRISE_H)}" /></g>`;
  svg += `<g font-family="IBM Plex Mono,monospace" font-size="9.5" letter-spacing="1" fill="#E0662A" font-weight="500">`;
  // Place each label on whichever side of its line the legacy curve vacates in late year.
  const tail = pts[pts.length - 8];
  const setAbove = tail.set < SUNSET_H, riseBelow = tail.rise > SUNRISE_H;
  svg += `<text x="${X1 - 6}" y="${y(SUNSET_H) + (setAbove ? -8 : 15)}" text-anchor="end" ${halo}>SUNSET · 6:00 PM · ALWAYS</text>`;
  svg += `<text x="${X1 - 6}" y="${y(SUNRISE_H) + (riseBelow ? 15 : -8)}" text-anchor="end" ${halo}>SUNRISE · 6:00 AM · ALWAYS</text>`;
  svg += `</g>`;

  // label the first statutory jump on the sunset curve, if this location observes one
  for (let k = 1; k < pts.length; k++) {
    if (Math.abs(pts[k].set - pts[k - 1].set) > 0.5) {
      const top = Math.max(pts[k].set, pts[k - 1].set);
      svg += `<text x="${x(pts[k].i) - 4}" y="${y(top) - 8}" text-anchor="end" font-family="IBM Plex Mono,monospace" font-size="9.5" letter-spacing="1" fill="#B5472F" ${halo}>THE JUMP</text>`;
      break;
    }
  }

  $("chart-dyn").innerHTML = svg;
  $("chart-loc").textContent = (loc.source === "device" ? "Your location" : loc.name) + " · " + fmtCoords(loc);
}
renderChart();

/* ── pledge form → Google Form ── */
const form = $("pledge-form");
const countEl = $("pledge-count");
let pledges = 11432;

form.addEventListener("submit", (e) => {
  e.preventDefault();
  const email = $("pledge-email");
  if (!email.value || !email.checkValidity()) { email.focus(); return; }

  if (GOOGLE_FORM_ACTION.indexOf("YOUR_FORM_ID") === -1) {
    // Real submission via hidden iframe (Google Forms allows cross-origin POST)
    const f = document.createElement("form");
    f.action = GOOGLE_FORM_ACTION;
    f.method = "POST";
    f.target = "gform-sink";
    f.style.display = "none";
    const inp = document.createElement("input");
    inp.name = GOOGLE_FORM_EMAIL_FIELD;
    inp.value = email.value;
    f.appendChild(inp);
    document.body.appendChild(f);
    f.submit();
    f.remove();
  }

  pledges += 1;
  countEl.textContent = pledges.toLocaleString();
  $("pledge-inline").textContent = pledges.toLocaleString() + " citizens have pledged";
  form.style.display = "none";
  $("form-success").style.display = "block";
});

$("yr").textContent = String(new Date().getFullYear());
</script>
